# -----------------------------------------------------------------------------
# ВСМ-Тренажер — Базовая конфигурация окружения
# -----------------------------------------------------------------------------

# Режим работы (development / production)
ENV=development

# Backend настройки
PROJECT_NAME="VSM Conductor Simulator"
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# CORS: список разрешенных origins (строка через запятую или JSON-массив)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]

# Frontend настройки
VITE_API_URL=/api/v1

# Заглушки для будущих сервисов и БД
SECRET_KEY=dev_insecure_secret_key_change_me_in_production
DATABASE_URL=sqlite+aiosqlite:///./vsm_simulator.db
